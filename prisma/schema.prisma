// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  name              String?
  azureAdId         String? // Azure AD object ID (oid) — required for Teams Calls API
  // Per-user MCP bridge token (Claude Desktop). Plaintext is shown to
  // the user once at generation; we only persist a SHA-256 hash so a DB
  // leak doesn't expose the token. mcpTokenHint stores the last 4 chars
  // of the plaintext so the UI can show "ending in …ABCD".
  mcpTokenHash      String?
  mcpTokenHint      String?
  mcpTokenCreatedAt DateTime?
  createdAt         DateTime  @default(now())

  sequences              Sequence[]
  integrationCredentials IntegrationCredential[]
  ownedProspects         Prospect[]              @relation("OwnedBy")
  ownedAccounts          Account[]
  prospectOwnerships     ProspectOwner[]
  enrolledEnrollments    SequenceEnrollment[]    @relation("EnrolledBy")
  vmRecordings           VmRecording[]
}

model Account {
  id                 Int        @id @default(autoincrement())
  name               String
  domain             String?
  website            String?
  industry           String?
  subIndustry        String?
  revenue            String? // e.g. "$10M–$50M"
  employees          String? // e.g. "100–500"
  country            String?
  region             String?
  city               String?
  description        String?
  notes              String?
  researchSummary    String? // AI / uploaded account-level research brief; flows into prospect brief generation
  status             String     @default("prospect") // prospect | customer | churned | partner
  tier               String? // enterprise | mid-market | smb
  techStack          String?
  tags               String? // JSON array
  linkedInUrl        String?
  twitterUrl         String?
  foundedYear        Int?
  // FY27 account-tracker fields (from BDR Excel import)
  priorityTier       String? // A-Existing | A-Priority | B-Pursue | B-Watch
  dealMotion         String?
  targetCloseDate    DateTime?
  closeQuarter       String?
  useCases           String? // free text — top use cases for personalization
  primaryStakeholder String?
  backupStakeholders String?
  warmIntroPaths     String?
  weeklyFocus        String?
  outreachStatus     String? // Not Started | Research Phase | Outreach Sent | In Conv...
  lastContactedAt    DateTime?
  myNotes            String?
  rep                String? // denormalized rep name from Excel
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  prospects          Prospect[]
  owners             User[]
}

model Prospect {
  id                  Int                  @id @default(autoincrement())
  firstName           String
  lastName            String
  email               String               @unique
  companyName         String?
  title               String?
  phone               String?
  enrichmentStatus    String               @default("pending")
  status              String               @default("Uncontacted")
  notes               String?
  researchBrief       String?
  country             String?
  region              String?
  techStack           String?
  tags                String? // JSON array of strings e.g. '["enterprise","Q2-target"]'
  trackingPixelData   String? // JSON string — legacy enrichment data (phone, linkedIn, timezone)
  accountId           Int?
  account             Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  ownedById           Int?
  owner               User?                @relation("OwnedBy", fields: [ownedById], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now())
  sequenceEnrollments SequenceEnrollment[]
  emailActivities     EmailActivity[]
  callActivities      CallActivity[]
  replyActivities     ReplyActivity[]
  meetingActivities   MeetingActivity[]
  owners              ProspectOwner[]
}

model ProspectOwner {
  prospectId Int
  userId     Int
  assignedAt DateTime @default(now())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([prospectId, userId])
}

model Sequence {
  id                  Int                  @id @default(autoincrement())
  name                String
  userId              Int?
  user                User?                @relation(fields: [userId], references: [id])
  steps               SequenceStep[]
  prospectEnrollments SequenceEnrollment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  schemaTag           String               @default("default")
}

model SequenceStep {
  id              Int             @id @default(autoincrement())
  sequenceId      Int
  sequence        Sequence        @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order           Int
  stepType        String          @default("AUTO_EMAIL")
  delayDays       Int
  subject         String          @default("")
  body            String          @default("")
  // AI personalization (Track B)
  aiPersonalize   Boolean         @default(false)
  aiPurpose       String? // one-line intent — e.g. "Cold open, hook with priority use case"
  aiInstructions  String? // multi-line voice/style/constraint guide
  aiModel         String? // override provider model — e.g. "gemini-2.5-pro"
  // Threading: when true, the step is sent as a reply to the most recent
  // sent email for this enrollment, so it appears in the same Outlook
  // thread instead of starting a fresh one.
  replyToPrevious Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  schemaTag       String          @default("default")
  emailActivities EmailActivity[]
  callActivities  CallActivity[]
}

model SequenceEnrollment {
  id                Int               @id @default(autoincrement())
  prospectId        Int
  sequenceId        Int
  currentStepOrder  Int               @default(0)
  status            String            @default("active")
  nextStepDue       DateTime?
  lastContactedAt   DateTime?
  completedAt       DateTime?
  optedOutAt        DateTime?
  pausedAt          DateTime?
  pausedReason      String?
  resumeAt          DateTime?
  enrolledAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  enrolledById      Int?
  enrolledBy        User?             @relation("EnrolledBy", fields: [enrolledById], references: [id], onDelete: SetNull)
  emailActivities   EmailActivity[]
  callActivities    CallActivity[]
  replyActivities   ReplyActivity[]
  meetingActivities MeetingActivity[]

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([prospectId, sequenceId])
}

model EmailActivity {
  id                Int       @id @default(autoincrement())
  prospectId        Int
  sequenceStepId    Int
  enrollmentId      Int
  status            String    @default("sent") // sent | opened | failed | cancelled | draft_pending | rejected
  subject           String    @default("")
  scheduledFor      DateTime?
  sentAt            DateTime?
  openedAt          DateTime?
  failureReason     String?
  externalMessageId String? // Nodemailer Message-ID for In-Reply-To matching
  // AI personalization draft fields (Track B)
  draftBody         String? // AI-generated body awaiting HITL approval
  draftPrompt       String? // full prompt sent to the model (for HITL display + regenerate)
  draftReasoning    String? // model's reasoning chain (if returned)
  draftModel        String? // e.g. "gemini-2.5-pro"
  draftProvider     String? // "gemini" | "claude"
  createdAt         DateTime  @default(now())

  prospect     Prospect           @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  sequenceStep SequenceStep       @relation(fields: [sequenceStepId], references: [id], onDelete: Cascade)
  enrollment   SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model CallActivity {
  id             Int       @id @default(autoincrement())
  prospectId     Int
  sequenceStepId Int?
  enrollmentId   Int?
  // planned | completed | skipped | no_answer | voicemail | connected | cancelled
  status         String    @default("planned")
  scheduledFor   DateTime?
  completedAt    DateTime?
  durationSecs   Int?
  notes          String?
  outcome        String? // connected | voicemail | no_answer | left_message
  createdAt      DateTime  @default(now())

  prospect     Prospect            @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  sequenceStep SequenceStep?       @relation(fields: [sequenceStepId], references: [id], onDelete: SetNull)
  enrollment   SequenceEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
}

model ReplyActivity {
  id                Int       @id @default(autoincrement())
  prospectId        Int
  enrollmentId      Int
  sequenceId        Int
  fromEmail         String
  subject           String
  bodySnippet       String?
  // ooo | genuine_reply | bounce | unsubscribe | unknown
  classification    String
  oooReturnDate     DateTime?
  externalMessageId String? // Message-ID of the reply, for deduplication
  receivedAt        DateTime
  processedAt       DateTime?
  createdAt         DateTime  @default(now())

  prospect   Prospect           @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  enrollment SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model MeetingActivity {
  id           Int      @id @default(autoincrement())
  prospectId   Int
  enrollmentId Int?
  title        String   @default("Meeting")
  scheduledFor DateTime
  durationMins Int?
  outcome      String? // completed | no_show | rescheduled | cancelled
  notes        String?
  source       String   @default("manual") // manual | call_outcome
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prospect   Prospect            @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  enrollment SequenceEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
}

model IntegrationCredential {
  id           Int      @id @default(autoincrement())
  provider     String
  clientId     String
  clientSecret String
  refreshToken String?
  email        String?
  userId       Int
  tenantId     String? // Microsoft tenant ID (tid) — required for Calls API app token
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([provider, userId])
}

model VmRecording {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  durationSecs Float?
  audioData    Bytes // WAV PCM 16kHz 16-bit mono — required format for Microsoft Graph playPrompt
  mimeType     String   @default("audio/wav")
  createdAt    DateTime @default(now())
}

// Paced outbound send queue for the MCP bridge. Independent of sequence
// enrollments (EmailActivity requires enrollment/step FKs; ad-hoc bridge
// sends have neither). Drained by services/sendQueueWorker.js at the
// configured pace, within the send window, under the per-day cap.
model OutboundQueue {
  id                  Int       @id @default(autoincrement())
  userId              Int // sending Microsoft account (resolves the credential)
  trackingId          String    @unique // returned to the caller for status polling
  to                  String
  subject             String    @default("")
  body                String    @default("")
  cc                  String?
  bcc                 String?
  // When set, this row is sent as a threaded reply (paced) rather than a new send.
  inReplyToMessageId  String?
  replyAll            Boolean   @default(false)
  includeOriginalBody Boolean   @default(true)
  batchId             String? // groups a day's batch for reconciliation
  // clientRef: the caller's own key (e.g. Prospect ID "P0214"). Persisted for the
  // life of the row and returned on every status read so reconcile can join sent
  // emails back to workbook rows on (clientRef, internetMessageId).
  clientRef           String?
  // meta: opaque caller-supplied JSON blob (e.g. {"step":2,"lane":1}). Stored and
  // returned verbatim; the connector never inspects or validates it.
  meta                String?
  // attachments: JSON array of inline-image REFERENCES (not bytes), e.g.
  // [{"assetId":"asset_ab12","contentId":"orderalloc","inline":true}]. The bytes
  // live once in EmailAsset; the worker resolves each ref at send time and passes
  // #microsoft.graph.fileAttachment objects to Graph. Kept as refs (not inline
  // base64) so a 142-item batch POST stays small and the DB stores each image once.
  attachments         String?
  status              String    @default("queued") // queued | paused | sending | sent | failed | cancelled
  attempts            Int       @default(0)
  scheduledFor        DateTime? // earliest-eligible time (default: now); future-dating allowed
  sentAt              DateTime?
  messageId           String? // EWS / Graph item-id (internal handle) — NOT the RFC Message-ID
  internetMessageId   String? // RFC 5322 <…@…> Message-ID — the stable, dedupe-safe key
  conversationId      String?
  failureReason       String?
  createdAt           DateTime  @default(now())

  @@index([userId, status])
  @@index([batchId])
  @@index([clientRef])
}

// EmailAsset — a binary asset (currently inline email images) stored ONCE and
// referenced by many OutboundQueue rows via {assetId, contentId}. Storing the
// base64 here (instead of inline on every queue row) keeps a 142-item batch
// enqueue small and avoids duplicating a ~300KB image 142×. The worker loads the
// asset at send time and hands Graph a #microsoft.graph.fileAttachment with
// isInline + contentId, which the body references as <img src="cid:CONTENTID">.
model EmailAsset {
  id           Int      @id @default(autoincrement())
  assetId      String   @unique // stable handle returned to the caller (asset_<uuid>)
  userId       Int? // optional owner (the uploading Microsoft account)
  name         String // filename Graph shows, e.g. "order-allocation-A.png"
  contentType  String // MIME, e.g. "image/png"
  contentBytes String // base64 payload (NO data: prefix) — the raw file bytes
  byteSize     Int      @default(0) // decoded byte length, for sanity/limits
  createdAt    DateTime @default(now())

  @@index([userId])
}

// Per-user, per-day send policy. Cap + gate are supplied by the Cowork
// daily task (which reads Send Health); the connector enforces them.
// nextEligibleAt carries the pacing cursor between worker ticks.
model SendPolicy {
  id             Int       @id @default(autoincrement())
  userId         Int
  localDate      String // "YYYY-MM-DD" in the send timezone (PT)
  dailyCap       Int       @default(150)
  gate           String    @default("proceed") // proceed | warning | abort
  nextEligibleAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, localDate])
}

// ─── BDR workbook shadow tables (Phase 2 of the SQL port) ────────────────────
// A 1:1 mirror of the West Coast BDR workbook, loaded by a full-refresh import
// (scripts/bdrImport.js) from the exporter's JSON snapshot. During the shadow
// phase the WORKBOOK stays canonical; these tables exist to prove the DB
// reproduces metrics.py's numbers exactly before any cutover.
//
// DELIBERATELY no relations to the app's live models (Prospect,
// SequenceEnrollment, EmailActivity): the app's own schedulers act on those,
// and migrated data must never be mistaken for app-managed sequences.
// Rule-dependent derivations (send_dedup keys, group representatives,
// effective steps) are computed AT EXPORT by the same Python code metrics.py
// uses, so /api/mcp/bdr-metrics can aggregate without re-implementing rules.

// Provenance of the currently loaded snapshot. One row per import; the latest
// row describes what the Bdr* tables hold (wbSha256 ties every number back to
// an exact workbook file state, same as metrics.py output).
model BdrSnapshotMeta {
  id           Int      @id @default(autoincrement())
  importedAt   DateTime @default(now())
  wbSha256     String
  exportedAt   String // exporter's timestamp (local PT ISO)
  prospectRows Int
  emailLogRows Int
  seqStateRows Int
  note         String?
}

model BdrProspect {
  id                 Int     @id @default(autoincrement())
  pid                String  @unique // "P####" or legacy 12-char hex
  account            String?
  firstName          String?
  lastName           String?
  title              String?
  email              String? // lowercased; the workbook's global dedup key
  linkedinUrl        String?
  personaTier        String?
  owningRep          String?
  status             String?
  dncFlag            Boolean @default(false)
  notes              String?
  directPhone        String?
  mobilePhone        String?
  callCount          Int?
  lastCallOutcome    String?
  liConnectionStatus String?
  extraJson          String? // every remaining workbook column, verbatim — nothing dropped

  @@index([email])
  @@index([account])
}

model BdrSequenceState {
  id                  Int     @id @default(autoincrement())
  pid                 String  @unique // Sequence State "ID" column
  tier                String?
  name                String?
  account             String?
  industry            String?
  c3Product           String?
  sequenceStarted     String? // dates kept as ISO strings (workbook mixes types)
  currentStep         Int?
  lastSent            String?
  nextScheduled       String?
  channelNext         String?
  replyStatus         String? // canonical vocab (validated upstream)
  personalizationJson String?
  holdReason          String?
  variant             String?
  promptConfigVersion String?
  liStep              Int?
  liReplyStatus       String?
  stepsJson           String? // the 7 per-step blocks (subject/date/mid/conv/…), verbatim
  extraJson           String?

  @@index([replyStatus])
  @@index([account])
}

model BdrEmailLog {
  id                Int      @id @default(autoincrement())
  wbRow             Int      @unique // workbook row number — traceability + idempotent reload
  emailId           String?
  dateSent          String? // ISO as exported; original cell in extraJson if odd
  rep               String?
  repEmail          String?
  account           String?
  prospectName      String?
  prospectTitle     String?
  personaTier       String?
  email             String? // lowercased recipient
  subject           String?
  body              String?
  refCustomer       String?
  outcome           String?
  feedback          String?
  step              Int? // Sequence Step as stamped on the row (null = pre-stamping)
  variant           String?
  promptCfg         String?
  replySentiment    String?
  posture           String? // NEW | REPLY
  msgid             String?
  conversationId    String?
  pid               String?
  bounceType        String?
  sendStatus        String?
  sendTimestamp     String?
  lane              String?
  graphItemId       String?
  consolidationNote String?
  // ── derived at export by the SHARED Python rules (send_dedup + metrics.py) ──
  isInet            Boolean? // real RFC 5322 Message-ID vs EWS item-id
  sendKey           String? // serialized send_dedup key; rows sharing it = one physical send
  isGroupRep        Boolean  @default(false) // this row is the group's representative (metrics' rule)
  repDate           String? // representative's send date (ISO) — drives weekly buckets
  effectiveStep     Int? // metrics.py sent_by_step_effective inference (reps only)
  laneBucket        String? // metrics.py _lane_bucket(lane, repEmail) (reps only)
  extraJson         String?

  @@index([email])
  @@index([pid])
  @@index([sendStatus])
  @@index([sendKey])
  @@index([isGroupRep])
}

// Server-side send blocklist — the compliance floor every send path checks
// (enqueue validation + the worker's final pre-send check). Seeded from the
// workbook's lists (seq_engine HELD_DOMAINS / DNC / bounced / suppressed) and
// maintained via /api/mcp/blocklist. Rows are soft-disabled (active=false),
// never deleted, so the audit trail survives.
// kind: held_domain | suppressed_domain | dnc_email | bounced_email
model SendBlocklistEntry {
  id        Int      @id @default(autoincrement())
  kind      String
  value     String // lowercased domain or email address
  reason    String?
  source    String? // e.g. "workbook-seed-2026-07-17", "bounce-sweep", "manual"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, value])
  @@index([kind, active])
}

// Replay guard for enqueue_batch. A caller-supplied idempotencyKey maps to the
// BatchResult produced the first time that key was processed; a retry with the
// same key returns the stored result instead of re-queuing. `result` holds the
// JSON-serialized BatchResult. Rows older than the replay window are ignored
// (see services/enqueueBatch.js REPLAY_WINDOW_MS) and may be pruned later.
model BatchReceipt {
  id             Int      @id @default(autoincrement())
  idempotencyKey String   @unique
  userId         Int
  batchId        String?
  result         String // JSON-serialized BatchResult
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}
